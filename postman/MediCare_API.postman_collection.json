{
  "info": {
    "_postman_id": "7b3dfc55-3200-48b6-8f4c-medicare-collection",
    "name": "MediCare API",
    "description": "Production-grade Postman collection for MediCare API – Healthcare Management Backend.\nCovers Authentication, Patient Management, Doctor Directory, and Patient-Doctor Mappings with automated token chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
