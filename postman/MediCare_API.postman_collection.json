  "item": [
    {
      "name": "Authentication",
      "description": "Public authentication endpoints for user onboarding and JWT token lifecycle.",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User object returned without password\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"user\");",
                  "    pm.expect(json.user).to.have.property(\"email\");",
                  "    pm.expect(json.user).to.not.have.property(\"password\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Doe\",\n  \"email\": \"jane.doe@hospital.org\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Register a new user account with full name, unique email, and strong password."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"JWT access and refresh tokens returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"access\");",
                  "    pm.expect(json).to.have.property(\"refresh\");",
                  "    pm.collectionVariables.set(\"access_token\", json.access);",
                  "    pm.collectionVariables.set(\"refresh_token\", json.refresh);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@hospital.org\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Authenticate user credentials and automatically populate {{access_token}} and {{refresh_token}} collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"New access token generated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"access\");",
                  "    pm.collectionVariables.set(\"access_token\", json.access);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh", ""]
            },
            "description": "Exchange a valid refresh token for a fresh short-lived access token."
          }
        }
      ]
    },
